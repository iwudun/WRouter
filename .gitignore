# ===== 依赖 / 虚拟环境 =====
node_modules/
**/node_modules/
.venv/
venv/

# ===== 构建产物 =====
# 安装包与解包目录（构建脚本输出在 build/dist/，顶层规则为历史产物防御）
dist/
dist-*/
dist-new/
dist-final/
dist-final2/
release/
release-local/

# 各模块的编译产物（可由构建命令重新生成）
frontend/dist/
backend/dist/

# build/ 目录：图标(build/icons/) + 构建清单(build/build-info.json)
# + 打包产物(build/dist/<时间戳>/win|linux/)。整个目录忽略。
build/

# Tauri 桌面壳(desktop/src-tauri,独立 Cargo 工程)
# target/ 编译产物；gen/ 与 src/permissions/autogenerated/ 由 tauri-build 生成。
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/src/permissions/autogenerated/

# 打包出的安装包
*.exe
*.msi
*.dmg
*.AppImage
*.rpm
*.deb
*.snap
*.blockmap

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.eggs/

# ===== 运行时数据 / 日志 =====
# 开发模式数据与日志（desktop/src-tauri/src/backend.rs 重定向；
# 含 config.sqlite、API key 等敏感数据，严禁入库）
.dev/
# 后端诊断与运行数据
*.log
logs/
# 前端日志解析源码目录与运行日志目录同名,单独放行。
!frontend/src/pages/home/shared/logs/
!frontend/src/pages/home/shared/logs/**
*.ready.json

# 桌面应用运行时数据（不应入库）
.bot-gateway-state
.agent-data

# ===== 临时文件 =====
.tmp/
tmp/
*.tmp
*.bak
# 验证脚本与日志（一次性核验用，不入库）
.verify-tmp/

# ===== 编辑器 / IDE =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== 系统 / 其他 =====
.DS_Store
Thumbs.db
desktop.ini

# 环境变量与密钥（防止泄露）
.env
.env.*
!.env.example

# ===== golden replay 运行时报告（20261016_02：运行时数据不入库） =====
testdata/golden/parity-report.json
